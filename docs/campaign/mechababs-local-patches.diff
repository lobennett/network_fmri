 def build_eligibility(rule):
     """A predicate over an aggregated row, from a pipeline's ``selection:`` config:
-    every ``require_datatypes`` present AND every ``require_positive`` count > 0.
+    every ``require_datatypes`` present, at least one ``require_any_datatypes`` present,
+    AND every ``require_positive`` count > 0.
+
+    ``require_any_datatypes`` is the OR to ``require_datatypes``' AND. MRIQC has something
+    to say about a session holding *either* anat or func, so requiring both would drop
+    anat-only visits while requiring neither would queue a session holding only a fieldmap.
 
     The rule names TSV columns directly (``t1w_num``, …), so a new app's needs are
     data, not code."""
     req_datatypes = rule.get("require_datatypes", [])
+    req_any = rule.get("require_any_datatypes", [])
     req_positive = rule.get("require_positive", [])
 
     def eligible(agg):
         return (all(dt in agg["datatypes"] for dt in req_datatypes)
+                and (not req_any or any(dt in agg["datatypes"] for dt in req_any))
                 and all(agg["counts"].get(c, 0) > 0 for c in req_positive))
     return eligible
 
