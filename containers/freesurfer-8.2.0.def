Bootstrap: docker
From: ubuntu:24.04

# Build from the repository root. The required SHA-256 build argument binds the
# downloaded installer; register and pin the resulting SIF checksum separately.
%arguments
    FS_DEB_SHA256=

%files
    src/network_fmri/freesurfer_app.py /opt/network-freesurfer.py

%post
    set -eu
    export DEBIAN_FRONTEND=noninteractive
    apt-get update
    apt-get install -y --no-install-recommends ca-certificates curl python3
    test -n '{{ FS_DEB_SHA256 }}'
    curl -fL --retry 3 -o /tmp/freesurfer.deb https://surfer.nmr.mgh.harvard.edu/pub/dist/freesurfer/8.2.0/freesurfer_ubuntu24-8.2.0_amd64.deb
    printf '%s  /tmp/freesurfer.deb\n' '{{ FS_DEB_SHA256 }}' | sha256sum -c -
    apt-get install -y /tmp/freesurfer.deb
    rm /tmp/freesurfer.deb
    test -f /usr/local/freesurfer/8.2.0/SetUpFreeSurfer.sh
    apt-get clean

%environment
    export FREESURFER_HOME=/usr/local/freesurfer/8.2.0
    export FSLOUTPUTTYPE=NIFTI_GZ

%runscript
    #!/bin/bash
    source "$FREESURFER_HOME/SetUpFreeSurfer.sh"
    exec /usr/bin/python3 /opt/network-freesurfer.py "$@"

%test
    test -f /usr/local/freesurfer/8.2.0/build-stamp.txt
    grep -F '8.2.0' /usr/local/freesurfer/8.2.0/build-stamp.txt
