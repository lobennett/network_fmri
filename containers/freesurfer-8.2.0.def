Bootstrap: docker
From: freesurfer/freesurfer@sha256:5648104ca75a24f6ee5a8786146f99b405c2bda1da12bff723a15056da8ddf6b

# Official FreeSurfer 8.2.0 image, including upstream updates. Build from the
# repository root; the license is mounted at runtime, never copied into the image.
%files
    src/network_fmri/freesurfer_app.py /opt/network-freesurfer.py

%runscript
    #!/bin/bash
    source "$FREESURFER_HOME/SetUpFreeSurfer.sh"
    exec "$FREESURFER_HOME/python/bin/python3" /opt/network-freesurfer.py "$@"

%test
    grep -F '8.2.0' "$FREESURFER_HOME/build-stamp.txt"
    "$FREESURFER_HOME/python/bin/python3" /opt/network-freesurfer.py --help
